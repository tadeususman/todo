# ---- database ----
# wajib; contoh generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# ---- app ----
TZ=Asia/Jakarta

# ---- single-user bootstrap ----
# admin user dibuat otomatis saat startup kalau belum ada
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ---- LLM ----
# bridge = claude via claude-bridge host service (default)
# gemini = fallback / cheaper option
AI_PROVIDER=bridge
BRIDGE_URL=http://host.docker.internal:8765
BRIDGE_MODEL=claude-sonnet-4-6

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- reverse proxy ----
# CIDR/IP yang boleh mengirim X-Real-IP (kosong = loopback + jaringan privat)
# TRUSTED_PROXIES=

# ---- email (opsional; tanpa ini fitur "Lupa password" mati dan user minta reset ke admin) ----
# PUBLIC_URL dipakai untuk tautan di email, wajib https di produksi
# PUBLIC_URL=https://todo.contoh.com
# REDIRECT_HOSTS: domain lama (pisahkan dengan koma) yang dialihkan permanen ke PUBLIC_URL
# REDIRECT_HOSTS=todo-lama.contoh.com
# SUPPORT_EMAIL tampil di halaman /privasi dan /hapus-akun (wajib untuk Google Play)
# SUPPORT_EMAIL=halo@contoh.com

# Opsional: alert Telegram ke admin saat ada pendaftar baru (termasuk tamu yang mendaftar dari mode coba).
# Buat bot lewat @BotFather, chat id lewat @userinfobot (untuk grup: tambahkan bot ke grup, lalu pakai id grup, biasanya diawali -100).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Untuk app Android (TWA): package name dan sidik jari SHA-256 sertifikat penandatangan
# (dari Play Console -> App integrity; pisahkan dengan koma bila lebih dari satu).
# Selama kosong, /.well-known/assetlinks.json mengembalikan 404.
# ANDROID_PACKAGE=id.biz.todo_app.twa
# ANDROID_SHA256=AA:BB:...
# SMTP_HOST=smtp.contoh.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=todo <noreply@contoh.com>
