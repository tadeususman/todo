# ---- database ----
POSTGRES_PASSWORD=changeme

# ---- app ----
SESSION_SECRET=generate-a-long-random-string
TZ=Asia/Jakarta

# ---- single-user bootstrap ----
# admin user dibuat otomatis saat startup kalau belum ada
ADMIN_USERNAME=tade
ADMIN_PASSWORD=change-me-after-first-login

# ---- LLM ----
# bridge = claude via claude-bridge host service (default)
# gemini = fallback / cheaper option
AI_PROVIDER=bridge
BRIDGE_URL=http://host.docker.internal:8765
BRIDGE_MODEL=claude-sonnet-4-6

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
